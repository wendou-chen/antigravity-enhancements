{
  "name": "antigravity-enhancements",
  "displayName": "Antigravity Trancy & Web Enhancements",
  "description": "专为 Google Antigravity 打造的 Trancy 沉浸式翻译套件：划词翻译气泡、侧边栏生词本、LaTeX公式复制、Mermaid图表渲染。",
  "version": "2.3.0",
  "publisher": "antigravity-dev",
  "engines": {
    "vscode": "^1.68.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antiEnhance.toggle",
        "title": "Anti: 开启/关闭增强套件"
      },
      {
        "command": "antiEnhance.reinject",
        "title": "Anti: 重新注入增强脚本 (热重载)"
      },
      {
        "command": "antiEnhance.translateSelection",
        "title": "Trancy: 划词翻译选区 (Alt+T)"
      },
      {
        "command": "antiEnhance.openVocabulary",
        "title": "Trancy: 打开生词本"
      },
      {
        "command": "antiEnhance.exportVocabulary",
        "title": "Trancy: 导出生词本 (Markdown/CSV)"
      }
    ],
    "configuration": {
      "title": "Antigravity Web Enhancements",
      "properties": {
        "antiEnhance.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "是否启用 Antigravity 全能增强套件"
        },
        "antiEnhance.formulaCopy": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "是否启用 LaTeX 公式单击一键复制源码"
        },
        "antiEnhance.mermaidRender": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "是否启用 Mermaid 图表实时交互渲染与切换"
        },
        "antiEnhance.quoteReply": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "是否启用划词引用回复气泡"
        },
        "antiEnhance.floatingBall": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "是否在右下角常驻显示悬浮控制球 (FAB)"
        },
        "antiEnhance.sendMode": {
          "type": "string",
          "enum": [
            "ctrl-enter",
            "enter"
          ],
          "default": "ctrl-enter",
          "scope": "window",
          "description": "消息发送快捷键模式 (ctrl-enter: Ctrl+Enter发送/Enter换行, enter: Enter发送/Shift+Enter换行)"
        },
        "antiEnhance.trancyTranslate": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "是否开启 Trancy 划词翻译气泡"
        },
        "antiEnhance.gatewayUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "scope": "window",
          "description": "Gemini Web2API 统一网关地址 (用于极速 0 成本大模型翻译)"
        }
      }
    },
    "keybindings": [
      {
        "command": "antiEnhance.translateSelection",
        "key": "alt+t",
        "mac": "alt+t",
        "when": "editorHasSelection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anti-trancy-sidebar",
          "title": "Trancy 生词本",
          "icon": "src/assets/icon-book.svg"
        }
      ]
    },
    "views": {
      "anti-trancy-sidebar": [
        {
          "type": "webview",
          "id": "antiEnhance.vocabularyView",
          "name": "沉浸式生词本"
        }
      ]
    }
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}